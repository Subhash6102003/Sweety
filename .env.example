# ====================================================================
# Sweety - Environment Variables Template
# ====================================================================

# Node / Express Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=sweety-super-secret-jwt-key-2026-production

# Supabase / PostgreSQL Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Session mode or Direct)
# Example: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-supabase-project.supabase.co:5432/postgres

# Set to true for Supabase cloud SSL connection
DB_SSL=true

# Alternative individual parameters (if not using DATABASE_URL):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=sweety
